{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicGlass",
  "version": "0.1.0",
  "identifier": "com.musicglass.app",
  "build": {
    "beforeDevCommand": "cd ../../packages/ui && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../../packages/ui && pnpm build",
    "frontendDist": "../../../packages/ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MusicGlass",
        "width": 1244,
        "height": 849,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "本地音乐格式转换器",
    "category": "Utility",
    "resources": {
      "../../../resources/ffmpeg/bin/": "resources/ffmpeg/bin"
    }
  }
}
