!fixtures/**/*.flac
!fixtures/**/*.wav

# ---- Large binary test outputs ----
fixtures/**/output*/
fixtures/**/*.large.*

# ---- build artifacts ----
*.exe
*.msi
*.zip
*.7z
*.dll
*.dylib
!resources/**

# Bundled FFmpeg binary (downloaded at build time, NOT committed to git)
resources/ffmpeg/

